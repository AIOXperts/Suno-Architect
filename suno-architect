  setRatio(r: number) { this.compressor.setRatio(r); }
  
  setFrequency(f: number, sampleRate: number) {
    this.freq = f;
    this.scFilter.setHighPass(f, 0.707, sampleRate);
  }

  process(channels: Float32Array[]) {
