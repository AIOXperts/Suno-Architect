# --- File: /home/tim/Suno-Architect/src/services/mastering/nativeMasteringPipeline.ts ---
import { MasteringSettings } from '../offlineDb';
import { encodeWavAsync } from './wavEncoder';

const worker = new Worker(new URL('./masteringWorker.ts', import.meta.url), { type: 'module' });

export interface NativeMasteringProgress {
  phase: 'decode' | 'render' | 'encode';
  progress: number;
  message: string;
}

export interface NativeMasteringResult {
  blob: Blob;
  fileName: string;
  settingsForVariant: MasteringSettings;
}

export interface NativePreviewRenderResult {
  originalBuffer: AudioBuffer;
  previewBuffer: AudioBuffer;
  measuredLufs?: number;
}

export function createDefaultMasteringSettings(): MasteringSettings {
  return {
    inputGain: 0,
    glueCompression: false,
    deharsh: true,
    cleanLowEnd: true,
    autoLevel: false,
    addPunch: true,
    stereoWidth: 100,
    centerBass: true,
    cutMud: false,
    addAir: true,
    tapeWarmth: true,
    normalizeLoudness: true,
    targetLufs: -14,
    truePeakLimit: true,
    ceiling: -1,
    sampleRate: 48000,
    bitDepth: 24,
    eq: {
      low: 0,
      lowMid: 0,
      mid: 0,
      highMid: 0,
      high: 0,
    },
  };
}

export async function decodeAudioBlobToBuffer(blob: Blob): Promise<AudioBuffer> {
  // Try using audio element as fallback decoder
  return new Promise((resolve, reject) => {
    const audio = new Audio();
    audio.src = URL.createObjectURL(blob);
    audio.onloadedmetadata = () => {
      console.log('[DEBUG AUDIO DECODE] Audio element metadata:', {
        duration: audio.duration,
        src: audio.src,
        readyState: audio.readyState,
      });
    };
    audio.oncanplaythrough = () => {
      console.log('[DEBUG AUDIO DECODE] Audio element can play through');
      URL.revokeObjectURL(audio.src);
    };
    audio.onerror = () => {
      console.error('[DEBUG AUDIO DECODE] Audio element error');
      URL.revokeObjectURL(audio.src);
      reject(new Error('Audio element decode failed'));
    };
    
    // Fallback to Web Audio API
    const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
    blob.arrayBuffer().then(arrayBuffer => {
      ctx.decodeAudioData(arrayBuffer)
        .then(audioBuffer => {
          console.log('[DEBUG AUDIO DECODE] Web Audio API decode success:', {
            duration: audioBuffer.duration,
            length: audioBuffer.length,
            sampleRate: audioBuffer.sampleRate,
            numberOfChannels: audioBuffer.numberOfChannels,
          });
          resolve(audioBuffer);
        })
        .catch(err => {
          console.error('[DEBUG AUDIO DECODE] Web Audio API decode failed:', err);
          reject(err);
        })
        .finally(() => {
          ctx.close();
        });
    });
  });
}

function createAudioBuffer(channels: Float32Array[], sampleRate: number): AudioBuffer {
  const length = channels[0]?.length ?? 0;
  const audioBuffer = new AudioBuffer({
    numberOfChannels: channels.length,
    length,
    sampleRate,
  });
  channels.forEach((channel, index) => audioBuffer.copyToChannel(channel, index));
  return audioBuffer;
}

export async function renderNativeMasteredWavFromBlob(
  inputBlob: Blob,
  sourceFileName: string,
  settings: MasteringSettings,
  onProgress?: (update: NativeMasteringProgress) => void
): Promise<NativeMasteringResult> {
  onProgress?.({ phase: 'decode', progress: 0.1, message: 'Decoding source...' });
  const decoded = await decodeAudioBlobToBuffer(inputBlob);
  
  onProgress?.({ phase: 'render', progress: 0.3, message: 'Processing DSP chain...' });
  const masteredChannels = await runMasteringWorker(decoded, settings);
  
  onProgress?.({ phase: 'encode', progress: 0.8, message: 'Encoding WAV...' });
  const masteredBuffer = createAudioBuffer(masteredChannels, decoded.sampleRate);
  const wavBlob = await encodeWavAsync(masteredBuffer, decoded.sampleRate, (settings.bitDepth || 24) as 16 | 24);
  
  onProgress?.({ phase: 'encode', progress: 1.0, message: 'Done' });
  const fileName = sourceFileName.replace(/\.[^/.]+$/, "") + " (Mastered).wav";
  
  return { 
    blob: new Blob([wavBlob], { type: 'audio/wav' }), 
    fileName, 
    settingsForVariant: settings 
  };
}

export async function renderNativePreviewBufferFromBlob(
  inputBlob: Blob,
  settings: MasteringSettings,
  onProgress?: (update: NativeMasteringProgress) => void
): Promise<NativePreviewRenderResult> {
  onProgress?.({ phase: 'decode', progress: 0.1, message: 'Decoding source for preview...' });
  const decoded = await decodeAudioBlobToBuffer(inputBlob);
  
  onProgress?.({ phase: 'render', progress: 0.5, message: 'Rendering preview DSP...' });
  const masteredChannels = await runMasteringWorker(decoded, settings);
  const previewBuffer = createAudioBuffer(masteredChannels, decoded.sampleRate);
  
  return { 
    originalBuffer: decoded, 
    previewBuffer: previewBuffer 
  };
}

async function runMasteringWorker(buffer: AudioBuffer, settings: MasteringSettings): Promise<Float32Array[]> {
  return new Promise((resolve, reject) => {
    const id = Math.random();
    const channels: Float32Array[] = [];
    const transferables: ArrayBuffer[] = [];
    
    for (let i = 0; i < buffer.numberOfChannels; i++) {
      const data = buffer.getChannelData(i).slice();
      channels.push(data);
      transferables.push(data.buffer);
    }

const handler = (e: MessageEvent) => {
      if (e.data.id === id) {
        worker.removeEventListener('message', handler);
        if (e.data.success) {
          resolve(e.data.result.channels);
        } else {
          reject(new Error(e.data.error || 'Worker DSP error'));
        }
      }
    };

worker.addEventListener('message', handler);
    worker.postMessage({ 
      id, 
      data: { 
        channels, 
        sampleRate: buffer.sampleRate, 
        settings 
      } 
    }, transferables);
  });
}

